{
  "name": "citedesk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:smoke": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/db-smoke.ts",
    "corpus:fetch": "tsx scripts/corpus-fetch.ts",
    "corpus:check-anchors": "tsx scripts/corpus-check-anchors.ts",
    "ingest": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/ingest.ts",
    "search": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/search.ts",
    "ask": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/ask.ts",
    "eval:check": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/eval-check.ts",
    "eval:keys": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/eval-keys.ts",
    "eval:retrieval": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/eval-retrieval.ts",
    "eval:report": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/eval-report.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.107",
    "@ai-sdk/react": "4.0.165",
    "@supabase/supabase-js": "2.118.0",
    "ai": "7.0.161",
    "github-slugger": "2.0.0",
    "gpt-tokenizer": "4.1.0",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.1.0"
  }
}
