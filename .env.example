# Copy to .env.local and fill in. Never commit real values.
# Every variable here is server-only. Nothing needs a NEXT_PUBLIC_ key: the
# browser talks only to our own routes.

# OpenAI: answers, embeddings, reranking and the judge. The only model key needed.
# Read by @ai-sdk/openai by default.
OPENAI_API_KEY=

# Supabase: CiteDesk's own project, schema `citedesk`.
# The schema must be listed under Settings -> API -> Exposed schemas.
SUPABASE_URL=https://fscvgpzscquntewyfiqm.supabase.co
# sb_secret_... (Settings -> API Keys). Bypasses RLS; read only by lib/db/client.ts.
SUPABASE_SECRET_KEY=

# Langfuse Cloud, US region (week 5, T39). Tracing is skipped when these are empty.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Models. Defaults live in lib/models.ts; set these only to swap one in an eval run.
CITEDESK_ANSWER_MODEL=gpt-6-luna
CITEDESK_ESCALATION_MODEL=gpt-6.1-sol

# Retrieval. The refusal gate is the top chunk's vector similarity (T02); its value is tuned in
# T33 against the 10 unanswerable questions, so leave it empty until then.
CITEDESK_REFUSAL_THRESHOLD=
CITEDESK_RERANK_ENABLED=true

# Max answers per UTC day across all visitors: the budget guard for the public demo (200 is a starting guess).
CITEDESK_DAILY_ANSWER_CAP=200
